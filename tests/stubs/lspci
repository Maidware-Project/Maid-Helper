#!/bin/bash
echo "00:02.0 VGA compatible controller: Intel Test Graphics [8086:1234]"
if [ "${NVIDIA_VGA:-0}" = "1" ]; then
  echo "01:00.0 VGA compatible controller: NVIDIA Test GPU [10de:1234]"
  case "$*" in *-k*) printf '\tSubsystem: Test\n\tKernel driver in use: nouveau\n' ;; esac
fi
if [ "${AMD_VGA:-0}" = "1" ]; then
  echo "03:00.0 VGA compatible controller: Advanced Micro Devices [AMD/ATI] Test [1002:1234]"
  case "$*" in *-k*)
    if [ "${AMD_RV:-0}" = "1" ]; then
      printf '\tSubsystem: Test\n\tKernel driver in use: radeon\n'
    else
      printf '\tSubsystem: Test\n\tKernel driver in use: amdgpu\n'
    fi
    ;;
  esac
fi
exit 0
