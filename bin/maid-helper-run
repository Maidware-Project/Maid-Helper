#!/usr/bin/env bash
# GUI entry for Maid Helper: open it in a real terminal, not xterm.
# Terminal choice is generic: the freedesktop helper, then the user's own
# $TERMINAL, then the desktop's configured default, then a neutral fallback.
# No one machine's setup baked in.
BIN="$HOME/.local/bin/maid-helper"
desktop_term() {
  local app=""
  if command -v kreadconfig6 >/dev/null 2>&1; then
    app=$(kreadconfig6 --file kdeglobals --group General --key TerminalApplication 2>/dev/null)
  elif command -v kreadconfig5 >/dev/null 2>&1; then
    app=$(kreadconfig5 --file kdeglobals --group General --key TerminalApplication 2>/dev/null)
  fi
  if [ -z "$app" ] && command -v gsettings >/dev/null 2>&1; then
    app=$(gsettings get org.gnome.desktop.default-applications.terminal exec 2>/dev/null | tr -d "'")
  fi
  printf '%s' "$app"
}
term_flag() {
  case "$(basename "$1")" in
    gnome-terminal) printf '%s' '--' ;;
    xfce4-terminal) printf '%s' '-x' ;;
    wezterm) printf '%s' 'start --' ;;
    foot|blackbox-terminal) printf '%s' '' ;;
    *) printf '%s' '-e' ;;
  esac
}
pick_term() {
  local app="" name="" first=""
  if command -v xdg-terminal-exec >/dev/null 2>&1; then echo "xdg-terminal-exec"; return; fi
  if [ -n "${TERMINAL:-}" ] && command -v "${TERMINAL%% *}" >/dev/null 2>&1; then app="$TERMINAL"; fi
  [ -n "$app" ] || app=$(desktop_term)
  if [ -n "$app" ]; then
    # the desktop default only counts if it is really installed -
    # kreadconfig/gsettings happily point at long-gone terminals
    first="${app%% *}"
    if command -v "$first" >/dev/null 2>&1; then
      name=$(basename "$first")
      echo "$name $(term_flag "$name")"
      return
    fi
  fi
  for t in alacritty foot ghostty kitty konsole qterminal tilix wezterm xfce4-terminal gnome-terminal xterm; do
    command -v "$t" >/dev/null 2>&1 || continue
    echo "$t $(term_flag "$t")"
    return
  done
  echo ""
}
if [ -t 1 ]; then
  # already in a terminal: just run it
  exec "$BIN" "$@"
fi
TERM_CMD=$(pick_term)
if [ -z "$TERM_CMD" ]; then
  echo "No terminal found (install xdg-terminal-exec, or set \$TERMINAL)." >&2
  exit 1
fi
# keep the window open so the report is readable; when the check found
# trouble, offer the safe fixes right there (sudo asks inside). a run that
# was already --fix just waits.
OFFER_FIX=1
case " $* " in *" --fix "*) OFFER_FIX=0 ;; esac
export OFFER_FIX
# args travel in the environment, not in argv: some terminals rejoin the
# command line and split it in the wrong places (a "--check" ended up as
# "<bindir>/--check" once, reported 2026-10-19). the helper CLI is only
# spaceless options (--check, --fix, --only=...), so this is safe.
export HELPER_ARGS="$*"
KEEP_OPEN='"$0" $HELPER_ARGS; rc=$?; echo; if [ "$rc" = "2" ] && [ "$OFFER_FIX" = "1" ]; then read -r -p "apply the safe fixes now (sudo asks inside)? [y/N] " ans; case "$ans" in [Yy]*) "$0" --fix; rc=$? ;; esac; echo; fi; read -r -p "press enter to close " _; exit "$rc"'
# shellcheck disable=SC2086
exec $TERM_CMD bash -c "$KEEP_OPEN" "$BIN"
