#!/bin/sh
# Desktop entry point for Maid Helper. Never opens a terminal: it launches
# the native Qt GUI next to it, or shows a native error dialog if the GUI
# was not built on this machine.
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
for gui in "$here/maid-helper-gui" "$HOME/.local/bin/maid-helper-gui" /usr/bin/maid-helper-gui; do
  if [ -x "$gui" ]; then
    exec "$gui" "$@"
  fi
done
gui=$(command -v maid-helper-gui 2>/dev/null || true)
if [ -n "$gui" ]; then
  exec "$gui" "$@"
fi

msg="Maid Helper's native GUI is not installed. Re-run install.sh with CMake and Qt6 Widgets development files present (openSUSE: qt6-base-devel, Arch: qt6-base, Fedora: qt6-qtbase-devel, Debian: qt6-base-dev)."
if command -v kdialog >/dev/null 2>&1; then
  exec kdialog --title "Maid Helper" --error "$msg"
fi
if command -v zenity >/dev/null 2>&1; then
  exec zenity --error --title="Maid Helper" --text="$msg"
fi
if command -v notify-send >/dev/null 2>&1; then
  notify-send -i dialog-error "Maid Helper" "$msg"
fi
exit 1
